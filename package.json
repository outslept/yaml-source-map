{
  "name": "yaml-source-map",
  "version": "0.0.0",
  "keywords": [
    "ast",
    "node",
    "parser",
    "source-map",
    "typescript",
    "yaml"
  ],
  "homepage": "https://github.com/outslept/yaml-source-map#readme",
  "bugs": {
    "url": "https://github.com/outslept/yaml-source-map/issues"
  },
  "license": "MIT",
  "author": "outslept",
  "repository": {
    "type": "git",
    "url": "https://github.com/outslept/yaml-source-map.git"
  },
  "type": "module",
  "scripts": {
