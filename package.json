{
  "name": "yaml-source-map-x",
  "version": "0.0.0",
  "packageManager": "pnpm@10.10.0",
  "type": "module",
  "keywords": [
    "yaml",
    "source-map",
    "parser",
    "typescript",
    "node",
    "ast"
  ],
  "license": "MIT",
  "homepage": "https://github.com/outslept/yaml-source-map-x#readme",
  "bugs": {
    "url": "https://github.com/outslept/yaml-source-map-x/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/outslept/yaml-source-map-x.git"
  },
  "author": "outslept",
  "scripts": {
    "build": "tsdown src/yaml-source-map.ts",
    "dev": "tsdown src/yaml-source-map.ts --watch",
    "lint": "eslint",
    "lint:fix": "pnpm run lint --fix",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm run typecheck && pnpm run test:run && pnpm run build",
    "release": "bumpp && pnpm publish",
    "typecheck": "tsc --noEmit",
    "publint": "publint",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "ansis": "^4.1.0",
    "picocolors": "^1.1.1",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.4",
    "@sxzz/eslint-config": "^7.0.1",
    "@types/node": "^24.0.10",
    "bumpp": "^10.1.1",
    "eslint": "^9.27.0",
    "lint-staged": "^16.0.0",
    "simple-git-hooks": "^2.13.0",
    "tsdown": "^0.12.2",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  },
  "engines": {
    "node": ">=20"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix"
    ]
  }
}
